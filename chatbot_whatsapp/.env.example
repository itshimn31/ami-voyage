# ============================================================================
# Ami Voyages — Chatbot WhatsApp — Variables d'environnement
# ============================================================================
# Copier ce fichier vers `.env` et remplir avec les vraies valeurs.
# NE JAMAIS commiter le .env dans git.
# ----------------------------------------------------------------------------

# -- Serveur Express ---------------------------------------------------------
PORT=3000
NODE_ENV=development

# -- Twilio WhatsApp (canal d'envoi/réception) -------------------------------
# Trouvable dans la console Twilio > Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Numéro WhatsApp Twilio (sandbox: +14155238886, sinon votre numéro approuvé)
# IMPORTANT : préfixer par `whatsapp:`
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# -- Anthropic Claude API (NLP / classification / résumés) -------------------
# Clé API à créer sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèles utilisés (modifiables sans toucher au code)
# - Classification : tâche simple, modèle rapide/économique recommandé
# - Résumé agent  : qualité de français importante, modèle plus capable
ANTHROPIC_MODEL_CLASSIFICATION=claude-haiku-4-5
ANTHROPIC_MODEL_SUMMARY=claude-sonnet-4-6

# -- Numéro interne de l'agence (destinataire des résumés d'escalade) --------
# Format : whatsapp:+33XXXXXXXXX
AGENCY_INTERNAL_WHATSAPP=whatsapp:+33XXXXXXXXX

# -- Sessions ----------------------------------------------------------------
# Durée d'inactivité avant expiration (en ms). Défaut : 4 heures.
SESSION_TIMEOUT_MS=14400000

# Nombre maximum d'échanges avec le bot avant escalade automatique
MAX_EXCHANGES_BEFORE_ESCALATION=5

# Nombre de tentatives infructueuses (questions hors périmètre) avant escalade
MAX_FAILED_CLASSIFICATIONS=2
